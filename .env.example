NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=8001

# Frontend: API Base URL (required)
# This is where the frontend will send API requests to
# Examples:
#   - Local: http://localhost:8001
#   - LAN: http://192.168.1.100:8001
#   - Production: https://api.example.com
VITE_API_BASE_URL=http://localhost:8001

# Frontend: Use Vite dev proxy (optional, default: false)
# Set to true to use /api proxy instead of direct API calls
# This is a development convenience option, not recommended for production
VITE_USE_DEV_PROXY=false

# Backend: CORS allowed origins (comma-separated)
# List all frontend origins that should be allowed to access the API
# Examples:
#   - Local dev: http://localhost:5174
#   - LAN access: http://192.168.1.100:5174
#   - Production: https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=web_agent_flow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=web-agent-flow

CONSOLE_PORT=5174
WORKER_ENV=development
WORKER_POLL_INTERVAL=5
