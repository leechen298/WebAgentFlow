# Console Port
CONSOLE_PORT=5174

# API Base URL (required)
# This is where the frontend will send API requests to
# Examples:
#   - Local: http://localhost:8001
#   - LAN: http://192.168.1.100:8001
#   - Production: https://api.example.com
VITE_API_BASE_URL=http://localhost:8001

# Use Vite dev proxy (optional, default: false)
# Set to true to use /api proxy instead of direct API calls
# This is a development convenience option, not recommended for production
VITE_USE_DEV_PROXY=false

