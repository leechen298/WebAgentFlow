{
  "id": "google-search-basic",
  "name": "Google Search",
  "description": "Search-only MVP: open Google, submit a query, verify the results page.",
  "target_url": "https://www.google.com",
  "variables": {
    "query": "openai"
  },
  "steps": [
    {
      "intent": "fill_search_box",
      "action_type": "fill",
      "target_hint": {
        "tag": "textarea",
        "selector": "textarea[name=\"q\"], input[name=\"q\"]"
      },
      "value_from": "query"
    },
    {
      "intent": "submit_search",
      "action_type": "press",
      "target_hint": {
        "tag": "textarea",
        "selector": "textarea[name=\"q\"], input[name=\"q\"]"
      },
      "value": "Enter"
    },
    {
      "intent": "verify_results_page",
      "action_type": "observe",
      "success_criteria": {
        "conditions": [
          {
            "type": "url_contains",
            "value": "search?q=",
            "required": true
          },
          {
            "type": "no_error",
            "required": true
          }
        ]
      }
    }
  ],
  "global_success_criteria": {
    "conditions": [
      {
        "type": "url_changed",
        "required": true
      },
      {
        "type": "url_contains",
        "value": "search?q=",
        "required": true
      },
      {
        "type": "no_error",
        "required": true
      }
    ]
  },
  "source": "builtin",
  "provenance": "user_authored",
  "revision": 3
}
