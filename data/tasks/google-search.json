{
  "id": "google-search-basic",
  "name": "Google Search",
  "description": "Input a query, trigger search, verify results page appears.",
  "target_url": "https://www.google.com",
  "variables": {
    "query": "厦门天气"
  },
  "steps": [
    {
      "intent": "fill_search_box",
      "action_type": "fill",
      "target_hint": {
        "role": "combobox",
        "name": "搜索",
        "tag": "textarea"
      },
      "value_from": "query"
    },
    {
      "intent": "submit_search",
      "action_type": "press",
      "target_hint": {
        "role": "combobox",
        "name": "搜索",
        "tag": "textarea"
      },
      "value": "Enter"
    },
    {
      "intent": "verify_results_page",
      "action_type": "observe",
      "success_criteria": {
        "conditions": [
          {
            "type": "url_contains",
            "value": "search?q=",
            "required": true
          },
          {
            "type": "title_contains",
            "value_from": "query",
            "required": false
          }
        ]
      }
    }
  ],
  "global_success_criteria": {
    "conditions": [
      {
        "type": "url_changed",
        "required": true
      },
      {
        "type": "no_error",
        "required": true
      }
    ]
  },
  "source": "builtin",
  "provenance": "user_authored",
  "revision": 1
}
